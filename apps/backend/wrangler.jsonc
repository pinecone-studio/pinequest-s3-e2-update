{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-23",
  "compatibility_flags": ["nodejs_compat"],
  // Production: GraphQL + WebSocket CORS — таслалаар тусгаарласан frontend origin-ууд.
  // Жишээ: "vars": { "CORS_ORIGINS": "https://my-app.workers.dev,https://app.example.com" },
  // "vars": {
  //   "CORS_ORIGINS": ""
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "exam_grade_db",
      "database_name": "exam-grade-db",
      "database_id": "1af67fa5-a901-4a93-9710-f20af2b8f490",
      "remote": true,
      "migrations_dir": "drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXAM_MONITOR_ROOM",
        "class_name": "ExamMonitorRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "exam-monitor-room-v1",
      "new_sqlite_classes": ["ExamMonitorRoom"],
    },
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
